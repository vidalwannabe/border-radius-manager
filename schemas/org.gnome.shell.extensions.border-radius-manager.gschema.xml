<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema
    id="org.gnome.shell.extensions.border-radius-manager"
    path="/org/gnome/shell/extensions/border-radius-manager/"
  >

    <key name="settings-version" type="u">
      <!-- This gets set to the correct value when preferences are migrated -->
      <default>0</default>
    </key>

    <key name="blacklist" type="as">
      <default>[]</default>
      <summary>window here will not be rounded</summary>
      <description>
        The contents of the list represent the instance part of the window's
        `WM_CLASS`, as same as the output of `xprop WM_CLASS|cut -d \" -f 2`
      </description>
    </key>

    <key name="skip-libadwaita-app" type="b">
      <summary>Skip Libadwaita applications</summary>
      <default>true</default>
    </key>

    <key name="skip-libhandy-app" type="b">
      <summary>Skip LibHandy applications</summary>
      <default>false</default>
    </key>

    <key name="border-width" type="i">
      <summary>Border width for rounded corners window</summary>
      <range min="-40" max="40"/>
      <default>0</default>
    </key>

    <key name="global-rounded-corner-settings" type="a{sv}">
      <summary>Global rounded corners settings for all windows</summary>
      <default>
        <!--
          GLib.Variant is express as <type_name, value> in GSettings, but '<' and '>'
          is used to close tag in xml, so we have to use '&lt;' and '&rt;' when we
          want to set default value to Variant type.
        -->
        {
          'padding': &lt;{
            'left': &lt;uint32 1&gt;,
            'right': &lt;uint32 1&gt;,
            'top': &lt;uint32 1&gt;,
            'bottom': &lt;uint32 1&gt;
          }&gt;,
          'keepRoundedCorners': &lt;{
            'maximized': &lt;false&gt;,
            'fullscreen': &lt;false&gt;
          }&gt;,
          'borderRadius': &lt;uint32 12&gt;,
          'smoothing': &lt;0&gt;,
          'borderColor': &lt;[0.5, 0.5, 0.5, 1.0]&gt;,
          'enabled': &lt;true&gt;
        }
      </default>
    </key>

    <key name="custom-rounded-corner-settings" type="a{sv}">
      <summary>A directory to setup custom paddings for special windows</summary>
      <default>{}</default>
    </key>


    <key name="focused-shadow" type="a{si}">
      <summary>Shadow for focused window</summary>
      <default>
        {
          'horizontalOffset': 0,
          'verticalOffset': 4,
          'blurOffset': 28,
          'spreadRadius': 4,
          'opacity': 60
        }
      </default>
    </key>

    <key name="unfocused-shadow" type="a{si}">
      <summary>Shadow for unfocused window</summary>
      <default>
        {
          'horizontalOffset': 0,
          'verticalOffset': 2,
          'blurOffset': 12,
          'spreadRadius': -1,
          'opacity': 65
        }
      </default>
    </key>

    <key name="debug-mode" type="b">
      <summary>If enabled, extension will show debug info into journalctl</summary>
      <default>false</default>
    </key>

    <key name="tweak-kitty-terminal" type="b">
      <default>false</default>
    </key>

    <key name="enable-preferences-entry" type="b">
      <default>false</default>
    </key>

    <!-- Shell Elements tab: corner radius in pixels. -1 = system default, 0 = square corners. -->
    <key name="radius-popup" type="i"><range min="-1" max="60"/><default>-1</default><summary>Menus</summary></key>
    <key name="radius-datemenu" type="i"><range min="-1" max="60"/><default>-1</default><summary>Calendar / date</summary></key>
    <key name="radius-notification" type="i"><range min="-1" max="60"/><default>-1</default><summary>Notifications</summary></key>
    <key name="radius-modal" type="i"><range min="-1" max="60"/><default>-1</default><summary>Dialogs</summary></key>
    <key name="radius-dash" type="i"><range min="-1" max="60"/><default>-1</default><summary>Dash</summary></key>
    <key name="radius-switcher" type="i"><range min="-1" max="60"/><default>-1</default><summary>Alt+Tab</summary></key>
    <key name="radius-tile" type="i"><range min="-1" max="60"/><default>-1</default><summary>App icons</summary></key>
    <key name="radius-search" type="i"><range min="-1" max="60"/><default>-1</default><summary>Search results</summary></key>
    <key name="radius-search-entry" type="i"><range min="-1" max="60"/><default>-1</default><summary>Search bar</summary></key>
    <key name="radius-quick-settings" type="i"><range min="-1" max="60"/><default>-1</default><summary>Quick settings panel</summary></key>
    <key name="radius-quick-toggle" type="i"><range min="-1" max="60"/><default>-1</default><summary>Quick settings toggle buttons</summary></key>
    <key name="radius-quick-header" type="i"><range min="-1" max="60"/><default>-1</default><summary>Quick settings header buttons</summary></key>
    <key name="radius-quick-submenu" type="i"><range min="-1" max="60"/><default>-1</default><summary>Quick settings submenu boxes</summary></key>
    <key name="radius-media" type="i"><range min="-1" max="60"/><default>-1</default><summary>Media player</summary></key>
  </schema>
</schemalist>
